# Provider selected by default in the startup menu: bedrock | openai | ollama | lmstudio
DEFAULT_PROVIDER=bedrock


# bedrock
# credentials (leave commented to use `aws configure`)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BEDROCK_REGION=ap-south-1
# model: global.anthropic.claude-haiku-4-5-20251001-v1:0 | global.anthropic.claude-sonnet-5 | openai.gpt-oss-120b-1:0
BEDROCK_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# USD per 1M tokens (Haiku 4.5 = 1 / 5, Sonnet 5 = 2 / 10, Opus 5 = 5 / 25)
BEDROCK_INPUT_PRICE_PER_M=1
BEDROCK_OUTPUT_PRICE_PER_M=5
# model accepts images (screen control); gpt-oss is always text-only
BEDROCK_VISION=true


# openai
# credentials
OPENAI_API_KEY=
# optional: other OpenAI-compatible endpoint
OPENAI_BASE_URL=
# model
OPENAI_MODEL=
OPENAI_INPUT_PRICE_PER_M=
OPENAI_OUTPUT_PRICE_PER_M=
OPENAI_VISION=true


# ollama (local, free)
# connection
OLLAMA_BASE_URL=http://localhost:11434
# model (must support tool calling, e.g. qwen3:8b)
OLLAMA_MODEL=
# context window; the agent prompt needs ~8k+
OLLAMA_NUM_CTX=16384
OLLAMA_VISION=false


# lmstudio (local, free)
# connection (LM Studio > Developer > Start Server)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# model (exact id as shown in LM Studio)
LMSTUDIO_MODEL=
LMSTUDIO_VISION=false


# agent (all providers)
# cost per web search in USD (DuckDuckGo is free)
SEARCH_COST=0
# hard stop when today's total cost reaches this
MAX_DAILY_SPEND=5
MAX_STEPS=60
MAX_TOKENS=4096
SHELL_TIMEOUT=120
BROWSER_HEADLESS=false
