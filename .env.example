# AWS credentials: uses `aws configure` / ~/.aws by default.
# Uncomment only if you want to override them here.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock inference profile (list: aws bedrock list-inference-profiles)
# Cheaper option: global.anthropic.claude-sonnet-5 (then set prices 2 / 10)
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0 # global.anthropic.claude-opus-5

# Price per 1M tokens in USD (Opus 5 list price)
INPUT_PRICE_PER_M=5
OUTPUT_PRICE_PER_M=25

# Cost per web search in USD (DuckDuckGo is free)
SEARCH_COST=0

# Hard stop when today's total cost reaches this
MAX_DAILY_SPEND=2

# Agent limits
MAX_STEPS=60
MAX_TOKENS=4096
SHELL_TIMEOUT=120
BROWSER_HEADLESS=false
